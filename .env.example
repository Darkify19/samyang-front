# Copy to .env.local (development) or set in your host's dashboard (production).

# GraphQL endpoint exposed by samyang-back.
# Development default is http://localhost:3000/graphql when this is unset.
VUE_APP_GRAPHQL_URI=http://localhost:3000/graphql

# Cloudinary account used by the browser-side upload widget.
# Needs an *unsigned* upload preset. Falls back to the original demo account.
VUE_APP_CLOUDINARY_CLOUD_NAME=
VUE_APP_CLOUDINARY_UPLOAD_PRESET=
